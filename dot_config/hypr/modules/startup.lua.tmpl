-- Autostart per machine.

hl.on("hyprland.start", function()
    hl.exec_cmd("dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")
    hl.exec_cmd("systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP")
    hl.exec_cmd("noctalia -d")
{{- if eq (output "uname" "-n" | trim) "garuda" }}

    -- garuda workstation apps
    hl.exec_cmd("kitty", { workspace = "1" })
    hl.exec_cmd("code", { workspace = "2" })
    hl.exec_cmd("firedragon --restore", { workspace = "2" })
    hl.exec_cmd("kitty -o 'env=STARTUP_MUX=env HERDR_RADAR_STATE=$HOME/.local/state/herdr/plugins/hhdebb.herdr-radar-ws2 herdr --session ws2'", { workspace = "2" })
    hl.exec_cmd("sh -c 'sleep 2 && spotify'", { workspace = "special:spotify" })
    hl.timer(function() hl.dispatch(hl.dsp.focus({ workspace = 2 })) end, { timeout = 1000, type = "oneshot" })
{{- end }}
end)
