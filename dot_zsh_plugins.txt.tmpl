{{- /* antidote bundle list (mattmc3/antidote), loaded by dotfiles/config/zsh/plugins.sh */ -}}
{{- $linux := eq .chezmoi.os "linux" -}}
{{- $arch := false -}}
{{- $debian := false -}}
{{- if $linux -}}
{{-   $arch = or (eq .chezmoi.osRelease.id "arch") (contains "arch" (get .chezmoi.osRelease "idLike" | default "")) -}}
{{-   $debian = or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "ubuntu") (contains "debian" (get .chezmoi.osRelease "idLike" | default "")) (contains "ubuntu" (get .chezmoi.osRelease "idLike" | default "")) -}}
{{- end -}}
# oh-my-zsh libs, cherry-picked - the full oh-my-zsh is gone
ohmyzsh/ohmyzsh path:lib/functions.zsh
ohmyzsh/ohmyzsh path:lib/correction.zsh
ohmyzsh/ohmyzsh path:lib/history.zsh
ohmyzsh/ohmyzsh path:lib/key-bindings.zsh
ohmyzsh/ohmyzsh path:lib/completion.zsh
ohmyzsh/ohmyzsh path:lib/directories.zsh

# oh-my-zsh plugins
ohmyzsh/ohmyzsh path:plugins/chezmoi
ohmyzsh/ohmyzsh path:plugins/helm
ohmyzsh/ohmyzsh path:plugins/ssh
ohmyzsh/ohmyzsh path:plugins/sudo
ohmyzsh/ohmyzsh path:plugins/git
ohmyzsh/ohmyzsh path:plugins/vscode
ohmyzsh/ohmyzsh path:plugins/python
ohmyzsh/ohmyzsh path:plugins/docker
ohmyzsh/ohmyzsh path:plugins/podman
ohmyzsh/ohmyzsh path:plugins/tmux
{{ if eq .chezmoi.os "darwin" -}}
ohmyzsh/ohmyzsh path:plugins/brew
{{ end -}}
# enable on demand:
# ohmyzsh/ohmyzsh path:plugins/macos
# ohmyzsh/ohmyzsh path:plugins/oc
# ohmyzsh/ohmyzsh path:plugins/minikube
# ohmyzsh/ohmyzsh path:plugins/pipenv
# ohmyzsh/ohmyzsh path:plugins/dotnet
# ohmyzsh/ohmyzsh path:plugins/ansible

# ex-zplug plugins
Aloxaf/fzf-tab kind:defer
zsh-users/zsh-autosuggestions kind:defer
MichaelAquilina/zsh-you-should-use kind:defer
MichaelAquilina/zsh-autoswitch-virtualenv kind:defer
zshzoo/cd-ls kind:defer
MichaelAquilina/zsh-auto-notify kind:defer
fdellwing/zsh-bat kind:defer
dwaynebradley/k3d-oh-my-zsh-plugin kind:defer
hlissner/zsh-autopair kind:defer
zsh-users/zsh-completions kind:fpath
{{ if $arch -}}
Junker/zsh-archlinux kind:defer
{{ end -}}
{{ if $debian -}}
GeoLMg/apt-zsh-plugin kind:defer
{{ end -}}
{{ if not $arch -}}
# on Arch find-the-command (alias.sh) covers this
Freed-Wu/zsh-command-not-found kind:defer
{{ end -}}

# keep these two last, in this order
zsh-users/zsh-syntax-highlighting kind:defer
zsh-users/zsh-history-substring-search kind:defer
