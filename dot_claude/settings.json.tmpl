{
  "agentPushNotifEnabled": true,
  "askUserQuestionTimeout": "never",
  "autoUpdatesChannel": "latest",
  "disableClaudeAiConnectors": true,
  "editorMode": "normal",
  "effortLevel": "xhigh",
  "enabledPlugins": {},
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
{{- $agentHook := joinPath .chezmoi.homeDir ".claude/hooks/herdr-agent-state.sh" }}
{{- if stat $agentHook }}
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '{{ $agentHook }}' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
{{- end }}
  "language": "German",
  "model": "opus[1m]",
  "permissions": {
    "allow": [
      "mcp__claude-in-chrome__navigate",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__tabs_create_mcp",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__browser_batch"
    ],
    "ask": [
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(rsync:*)"
    ],
    "deny": [
      "Bash(sudo:*)"
    ]
  },
  "preferredNotifChannel": "kitty",
  "remoteControlAtStartup": {{ if eq (output "uname" "-n" | trim) "garuda" }}true{{ else }}false{{ end }},
  "skillOverrides": {
    "anthropic-skills:pdf": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:xlsx": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:computer-use": "off",
    "anthropic-skills:built-in-browser": "off",
    "anthropic-skills:chrome-browser": "off",
    "anthropic-skills:docs": "off",
    "anthropic-skills:morning": "off"
  },
  "statusLine": {
    "command": "ccstatusline",
    "padding": 0,
    "refreshInterval": 10,
    "type": "command"
  },
  "teammateMode": "auto",
  "tui": "default"
}
