README.md
CLAUDE.md
tests
tests/**

# claude code writes runtime state next to its settings; never manage these.
# .credentials.json holds an oauth token - it must not end up in the repo.
.claude/.credentials.json
.claude/history.jsonl
.claude/stats-cache.json
.claude/*.bak
.claude/*.orig
.claude/backups
.claude/projects
.claude/sessions
.claude/session-env
.claude/shell-snapshots
.claude/tasks
.claude/teams
.claude/telemetry
.claude/todos
.claude/ide
.claude/plugins
.claude/statsig
.claude/hooks

{{ if not (and (hasKey . "desktop") .desktop) }}
# GUI configs only land on desktop machines (answer 'desktop' at chezmoi init)
.config/hypr
.config/hypr/**
.config/ghostty
.config/ghostty/**
.config/kitty
.config/kitty/**
.config/noctalia
.config/noctalia/**
{{ end }}

{{ if ne (output "uname" "-n" | trim) "cachyos" }}
# Own Lua Hyprland setup, cachyos first. Hyprland prefers hyprland.lua over hyprland.conf and
# reloads on change, so applying it elsewhere would switch that session immediately.
.config/hypr/hyprland.lua
.config/hypr/modules
.config/hypr/modules/**
.config/hypr/bin
.config/hypr/bin/**
{{ else }}
# KoolDots user overrides (.conf), not read by the Lua setup
.config/hypr/UserConfigs
.config/hypr/UserConfigs/**
{{ end }}

{{ if not (has (output "uname" "-n" | trim) (list "cachyos" "garuda")) }}
# brain-dump vault auto-pull only on the machines that hold the vault
.config/systemd/user/brain-dump-pull.service
.config/systemd/user/brain-dump-pull.timer
# Moonlight/Sunshine stream command between the two machines
.local/bin/stream
{{ end }}

{{ if ne (output "uname" "-n" | trim) "cachyos" }}
# game streaming host setup (boot-time Hyprland session, Sunshine) only on the headless cachyos host
.local/share/game-streaming/hyprland-session.service
.config/sunshine/sunshine.conf
.config/systemd/user/sunshine-virt-output.service
.config/systemd/user/app-dev.lizardbyte.app.Sunshine.service.d
.config/systemd/user/app-dev.lizardbyte.app.Sunshine.service.d/**
{{ end }}
