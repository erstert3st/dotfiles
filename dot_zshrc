# --- GUI on demand (headless-boot box) ---
# Start the graphical desktop manually from the text console.
# Detaches any herdr client bound to a text console (ttyN) first, so the
# compositor doesn't bury the herdr TUI on that VT. The herdr server has no
# controlling tty and survives; reattach in a kitty under Hyprland with `herdr`.
alias gui='for p in $(pgrep -x herdr); do case "$(ps -o tty= -p $p 2>/dev/null)" in tty[0-9]*) kill $p 2>/dev/null ;; esac; done; uwsm start -e -D Hyprland -g -1 hyprland.desktop'

# Reminder shown only on a real text console (tty1), not inside Hyprland or ssh.
if [[ -o interactive && -z "$WAYLAND_DISPLAY" && "$(tty)" == /dev/tty[0-9]* ]]; then
  print -P "%F{cyan}┌──────────────────────────────────────────────┐%f"
  print -P "%F{cyan}│%f  Headless mode. To start the desktop, run:   %F{cyan}│%f"
  print -P "%F{cyan}│%f    %F{green}gui%f   %F{240}(starts Hyprland)       %f            %F{cyan}│%f"
  print -P "%F{cyan}└──────────────────────────────────────────────┘%f"
fi

