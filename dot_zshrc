alias fluxA='flux get helmreleases -A && echo -e "\n\n----------------- kustomizations ------------------------\n\n" && flux get kustomizations -A'
export DOCKER_BUILDKIT=1
export DISABLE_BRACKETED_PASTE=true
export UPDATE_AUR=1
export PACMAN_NOCONFIRM=1
#export BUILDKIT=1
export COMPOSE_DOCKER_CLI_BUILD=1
#export DOCKER_HOST=unix://$XDG_RUNTIME_DIR/podman/podman.sock
export DOCKER_HOST=unix:///var/run/docker.sock
alias headHard="headroom proxy --memory  --learn  --code-aware"
# headroom + serena only on demand; --no-mcp/--code-memory none stop wrap from
# registering MCP servers in user scope, they come from --mcp-config instead.
alias hclaude="HEADROOM_MODE=token HEADROOM_CODE_AWARE_ENABLED=1 HEADROOM_OUTPUT_SHAPER=1 headroom wrap claude --memory --learn --no-mcp --code-memory none --mcp-config ~/.claude/mcp/hclaude.json --settings ~/.claude/rtk-settings.json --append-system-prompt-file ~/.claude/RTK.md"
# Inkscape design session. The Inkscape GUI is the live D-Bus bridge for inkscape_mcp
# (the MCP only auto-starts it on Windows). Optional first arg: .svg to open.
# --append-system-prompt-file stays last: --mcp-config/--allowedTools are variadic and eat a prompt.
function desclaude {
  local file=""
  if [[ $1 == *.svg ]]; then file=${1:A}; shift; fi
  if [[ -z $WAYLAND_DISPLAY && -z $DISPLAY ]]; then
    print -u2 "desclaude: no GUI session, Inkscape not started (headless MCP only)"
  elif [[ -n $file ]] || ! pgrep -x inkscape >/dev/null; then
    setsid -f inkscape ${file:+"$file"} &>/dev/null
  fi
  claude --mcp-config ~/.claude/mcp/inkscape.json --allowedTools 'mcp__inkscape_mcp__*' \
    --append-system-prompt-file ~/.claude/designer.inkscape.md "$@"
}
# Claude in Chrome on demand (claudeInChromeDefaultEnabled is off to keep context small).
# Plain claude, no headroom: its lossy compression would mangle DOM/console/network output.
alias bclaude='claude --chrome'
# Homelab session: TrueNAS + Home Assistant MCP (tools pre-approved) plus Claude in Chrome.
# --chrome stays last: --mcp-config/--allowedTools are variadic and eat a prompt.
alias trueclaude="claude --mcp-config ~/.claude/mcp/truenas.json ~/.claude/mcp/ha-mcp.json --allowedTools 'mcp__truenas__*' 'mcp__ha-mcp__*' --chrome"
# --- GUI on demand (headless-boot box) ---
# Start the graphical desktop manually from the text console.
# Detaches any herdr client bound to a text console (ttyN) first, so the
# compositor doesn't bury the herdr TUI on that VT. The herdr server has no
# controlling tty and survives; reattach in a kitty under Hyprland with `herdr`.
alias gui='for p in $(pgrep -x herdr); do case "$(ps -o tty= -p $p 2>/dev/null)" in tty[0-9]*) kill $p 2>/dev/null ;; esac; done; uwsm start -e -D Hyprland -g -1 hyprland.desktop'

# Reminder shown only on a real text console (tty1), not inside Hyprland or ssh.
if [[ -o interactive && -z "$WAYLAND_DISPLAY" && "$(tty)" == /dev/tty[0-9]* ]]; then
  print -P "%F{cyan}┌──────────────────────────────────────────────┐%f"
  print -P "%F{cyan}│%f  Headless mode. To start the desktop, run:   %F{cyan}│%f"
  print -P "%F{cyan}│%f    %F{green}gui%f   %F{240}(starts Hyprland)       %f            %F{cyan}│%f"
  print -P "%F{cyan}└──────────────────────────────────────────────┘%f"
fi

alias pong='echo ping | $HOME/.local/bin/claude -p --model haiku --effort low'
